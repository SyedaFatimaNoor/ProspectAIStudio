NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Worker only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# OpenStreetMap Overpass. Set explicitly to enable discovery after reviewing usage policy.
OVERPASS_URL=
# Alternative free source for a locally run worker: a country extract from
# https://download.geofabrik.de (no key, no outbound request, no server).
# Takes precedence over OVERPASS_URL and cannot run on serverless hosting.
OSM_EXTRACT_PATH=
# Search radius in km around the city centre found inside the extract.
OSM_EXTRACT_RADIUS_KM=
# Hosted free source: search the OpenStreetMap snapshot stored in the workspace
# database instead of any endpoint. Build it locally with npm run osm:snapshot
# -- --load. Takes precedence over OSM_EXTRACT_PATH and works on serverless
# hosting; the app and the cloud worker read it, no file and no key needed.
OSM_SNAPSHOT=
# Optional Ollama Cloud key. Server-only; never prefix with NEXT_PUBLIC_.
OLLAMA_API_KEY=
# Optional OpenAI-compatible endpoint fallback, e.g. http://127.0.0.1:11434/v1
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
